# ====================================================================
# Сервис моих предпочтений — вся конфигурация только здесь.
# Скопируйте в .env, заполните и выполните: docker compose up -d --build
# ====================================================================

# --- OpenAI ---
OPENAI_API_KEY=                          # обязательно: ключ OpenAI или совместимого провайдера
OPENAI_BASE_URL=https://polza.ai/api/v1
OPENAI_STT_MODEL=openai/whisper-large-v3
OPENAI_LLM_MODEL=openai/gpt-4o-mini-2024-07-18
OPENAI_EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
STT_LANGUAGE=ru

# --- MCP ---
MCP_TOKEN=                               # обязательно; Bearer-токен, с которым агенты ходят в /mcp
MCP_ALLOW_WRITE=true

# --- Веб-интерфейс ---
# Вход в веб-интерфейс (обязательно): email и пароль администратора, пароль — не меньше 8 символов
ADMIN_EMAIL=
ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:3000
WEB_PORT=3000

# Публичные ссылки в шапке и подвале (пусто — кнопка не показывается)
TELEGRAM_URL=https://t.me/+bOIlWzeN4KVlNzAy
CONTACT_URL=https://t.me/W1DO_DIGITAL
STUDIO_URL=https://w1do.ru
STUDIO_NAME=W1DO Digital
YOUTUBE_URL=https://www.youtube.com/@w1do_digital

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=preferences
QDRANT_FOLDERS_COLLECTION=folders

# --- Поведение ---
CONFLICT_SCORE=0.80
SEARCH_TOP_K=10
MAX_AUDIO_MB=25
SEED_DEMO=false
LOG_LEVEL=info

# --- Бэкапы (сервис backup) ---
# Как часто снимать копию Qdrant, в часах (1–168). Healthcheck краснеет, если копии нет дольше 2 интервалов.
BACKUP_INTERVAL_HOURS=24
# Сколько последних копий хранить в volume backups
BACKUP_KEEP=14

# --- Образы (CI/CD и продакшен) ---
# Адрес образов в registry, например ghcr.io/w1do/perfomance-memory (локально можно не менять)
REGISTRY_IMAGE=preference-memory
# Тег образов: в продакшене — тег сборки из CI (short SHA) или latest
IMAGE_TAG=local
